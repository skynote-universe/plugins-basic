{
  "name": "@skynote/plugins-basic",
  "version": "0.1.0",
  "type": "module",
  "description": "SkyNote official basic nodes (sticky, text, shapes) and interactions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skynote-universe/plugins-basic.git"
  },
  "homepage": "https://github.com/skynote-universe/plugins-basic#readme",
  "bugs": {
    "url": "https://github.com/skynote-universe/plugins-basic/issues"
  },
  "keywords": [
    "whiteboard",
    "infinite-canvas",
    "sticky-note",
    "shapes",
    "connectors"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./sticky": {
      "types": "./src/nodes/sticky/index.ts",
      "import": "./src/nodes/sticky/index.ts"
    },
    "./free-text": {
      "types": "./src/nodes/free-text/index.ts",
      "import": "./src/nodes/free-text/index.ts"
    },
    "./shapes": {
      "types": "./src/nodes/shapes/index.ts",
      "import": "./src/nodes/shapes/index.ts"
    },
    "./interactions": {
      "types": "./src/interactions/index.ts",
      "import": "./src/interactions/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@skynote/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./sticky": {
        "types": "./dist/sticky.d.ts",
        "import": "./dist/sticky.js"
      },
      "./free-text": {
        "types": "./dist/free-text.d.ts",
        "import": "./dist/free-text.js"
      },
      "./shapes": {
        "types": "./dist/shapes.d.ts",
        "import": "./dist/shapes.js"
      },
      "./interactions": {
        "types": "./dist/interactions.d.ts",
        "import": "./dist/interactions.js"
      }
    }
  }
}
